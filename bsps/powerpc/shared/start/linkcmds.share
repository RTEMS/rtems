OUTPUT_FORMAT("elf32-powerpc", "elf32-powerpc",
              "elf32-powerpc")
OUTPUT_ARCH(powerpc)

/* Do we need any of these for elf?
   __DYNAMIC = 0;    */
MEMORY {
	VECTORS	: ORIGIN = 0x0 ,  LENGTH = 0x3000
	CODE : ORIGIN = 0x3000 , LENGTH = 32M - 0x3000
}

INCLUDE linkcmds.share_sections
